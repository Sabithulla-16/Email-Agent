# Environment: development | staging | production | test
ENVIRONMENT=development
DEBUG=true
HOST=0.0.0.0
PORT=8000

# Secret key for session cookie signing & CSRF protection (min 32 chars)
APP_SECRET_KEY=your_app_secret_key_minimum_32_characters_here

# Token Vault AES-256-GCM encryption key (32 bytes / 32 characters) & version
TOKEN_ENCRYPTION_KEY=your_32_byte_aes_encryption_key_here
TOKEN_KEY_VERSION=1

# Supabase (Server-side Secret Key ONLY - do NOT use anon key here)
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_SECRET_KEY=your_supabase_service_role_secret_key_here

# Redis & ARQ background queue
REDIS_URL=redis://localhost:6379/0

# Groq Cloud API
GROQ_API_KEY=your_groq_api_key_here
GROQ_FAST_MODEL=llama-3.1-8b-instant
GROQ_DRAFT_MODEL=llama-3.3-70b-versatile
GROQ_WHISPER_MODEL=whisper-large-v3-turbo

# Google Cloud OAuth 2.0 (Gmail integration)
GOOGLE_CLIENT_ID=your-google-oauth-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-oauth-client-secret
GOOGLE_REDIRECT_URI=http://localhost:8000/api/v1/auth/google/callback

# Telegram Bot
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_from_botfather
TELEGRAM_WEBHOOK_SECRET=your_telegram_webhook_secret_header_token
TELEGRAM_BOT_USERNAME=YourEmailAgentBot

# Frontend Client URL & CORS
FRONTEND_BASE_URL=http://localhost:3000
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# Email Sync & Processing
SYNC_LOOKBACK_DAYS=3
DRAFT_EXPIRY_HOURS=48
EMBEDDING_DIMENSION=384

# Optional: Sentry DSN
# SENTRY_DSN=https://examplePublicKey@o0.ingest.sentry.io/0
